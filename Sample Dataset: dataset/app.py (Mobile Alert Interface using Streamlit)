import streamlit as st
import joblib
import numpy as np

# Load trained model
model = joblib.load('model/heatwave_model.pkl')

st.title("Summer Heat Waves Mobile Alert System")

st.write("Enter today's weather data to get a heatwave alert prediction.")

temp = st.number_input("Temperature (°C)", min_value=20, max_value=60, step=1)
humidity = st.slider("Humidity (%)", 0, 100, 50)
wind = st.number_input("Wind Speed (km/h)", min_value=0, max_value=50, step=1)

if st.button("Check for Heatwave Alert"):
    prediction = model.predict(np.array([[temp, humidity, wind]]))[0]
    if prediction == 1:
        st.error("ALERT: High risk of heatwave! Stay indoors, stay hydrated.")
    else:
        st.success("No heatwave risk predicted today. Stay safe!")
